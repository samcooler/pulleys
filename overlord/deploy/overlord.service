[Unit]
Description=Overlord video/audio panel
After=overlord-update.service plymouth-start.service
Wants=overlord-update.service

[Service]
User=@USER@
SupplementaryGroups=video render audio input dialout
WorkingDirectory=@DIR@
EnvironmentFile=/etc/overlord.env
# Hand the screen from plymouth to mpv without flashing the console.
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
# mpv draws straight to the display via DRM/KMS; no X or Wayland on Lite.
ExecStart=/usr/bin/python3 @DIR@/overlord.py --mpv-arg=--vo=gpu --mpv-arg=--gpu-context=drm $OVERLORD_ARGS
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
