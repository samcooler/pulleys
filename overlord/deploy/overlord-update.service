[Unit]
Description=Overlord boot update (git pull + media sync)
After=network-online.target
Wants=network-online.target
Before=overlord.service

[Service]
Type=oneshot
User=@USER@
EnvironmentFile=/etc/overlord.env
ExecStart=@DIR@/deploy/update.sh
# On the screen as well as in the journal, so a long media sync shows "copying 12/44".
StandardOutput=journal+console
# update.sh never fails; the timeout only stops a hung sync blocking the show forever.
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
