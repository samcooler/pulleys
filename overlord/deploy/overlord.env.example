# Copied to /etc/overlord.env by install.sh. Edit, then `sudo systemctl restart overlord`.

# rclone remote to mirror into the media directory on every boot.
# Empty = no media sync. install.sh fills this in automatically once the
# Google Drive service-account key exists at ~/gdrive-sa.json (bootstrap.sh
# walks you through getting it; see README, "Media sync from Google Drive"):
#   OVERLORD_MEDIA_REMOTE=":drive,service_account_file=/home/overlord/gdrive-sa.json,root_folder_id=1ztfY8nkVEQuVMculoi4RvDAwYBr-PmnH,scope=drive.readonly:"
# Any other rclone remote:path (from `rclone config`) works too.
OVERLORD_MEDIA_REMOTE=

# Where synced media lives (kept out of the git checkout so git pull stays clean).
OVERLORD_MEDIA=/var/lib/overlord/media

# What this Pi is. Unset (or "overlord") is the Overlord: the video panel, and
# the one firmware updater for the whole mesh -- run exactly one. Any other name
# makes it a satellite that plays only cues addressed to it, e.g.
# "shrine__audio_once_bell" (see overlord/players.py). The name must be listed
# under `players:` in the game YAML.
#   OVERLORD_PLAYER=shrine
# What a satellite can do: sound (speaker only, the default) or image (a
# full-screen still image, plus sounds).
#   OVERLORD_PLAYER_KIND=image
OVERLORD_PLAYER=
OVERLORD_PLAYER_KIND=

# Extra overlord.py arguments, e.g. an explicit serial port or an HDMI audio device:
#   OVERLORD_ARGS=--serial-port /dev/ttyAMA0 --mpv-arg=--audio-device=alsa/hdmi:CARD=vc4hdmi0,DEV=0
OVERLORD_ARGS=

# The play log (every pull, every cue, what the game did) goes to
# /var/lib/overlord/playlog by default; set a directory to move it.
#   OVERLORD_PLAYLOG=/var/lib/overlord/playlog
# The live director tunes the game's knobs (params with a min and max) between
# sessions from how people play (playtest/README.md). 1 turns it on; a prior
# from `python3 -m playtest tune --out tune.json` gives it a head start.
OVERLORD_DIRECTOR=
#   OVERLORD_DIRECTOR_PRIOR=/home/overlord/tune.json
# Which knobs it may turn. One or two at a time: a session's score varies a lot
# with who walks in, so each knob takes a few hundred sessions to read.
#   OVERLORD_DIRECTOR_FOCUS=charge_per_pull

# Preferred bridge UART rate. New bridges boot at 921600; Overlord also probes
# legacy 115200 bridges automatically. Must match BRIDGE_BAUD for custom builds.
OVERLORD_SERIAL_BAUD=921600
