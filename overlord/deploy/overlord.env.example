# Copied to /etc/overlord.env by install.sh. Edit, then `sudo systemctl restart overlord`.

# rclone remote to mirror into the media directory on every boot.
# Leave empty to skip media sync. For the shared Google Drive folder, put the
# service-account JSON key at /home/overlord/gdrive-sa.json (see README,
# "Media sync from Google Drive") and use this connection string, so no
# `rclone config` is needed:
#   OVERLORD_MEDIA_REMOTE=":drive,service_account_file=/home/overlord/gdrive-sa.json,root_folder_id=1ztfY8nkVEQuVMculoi4RvDAwYBr-PmnH,scope=drive.readonly:"
# Any other rclone remote:path (from `rclone config`) works too.
OVERLORD_MEDIA_REMOTE=

# Where synced media lives (kept out of the git checkout so git pull stays clean).
OVERLORD_MEDIA=/var/lib/overlord/media

# Extra overlord.py arguments, e.g. an explicit serial port or an HDMI audio device:
#   OVERLORD_ARGS=--serial-port /dev/ttyAMA0 --mpv-arg=--audio-device=alsa/hdmi:CARD=vc4hdmi0,DEV=0
OVERLORD_ARGS=
